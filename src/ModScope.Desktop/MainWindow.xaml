<Window x:Class="ModScope.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ModScope"
        MinWidth="1180"
        MinHeight="760"
        Width="1450"
        Height="900"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <Style x:Key="MorePopupButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A4A5A" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#202124">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ModListColumn" Width="280" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition x:Name="ContextColumn" Width="2*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ToolbarHost" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="8,8,8,0" CornerRadius="12" Background="#292A2D">
            <wv2:WebView2 x:Name="ToolbarShell" />
        </Border>

        <Border x:Name="ModListShell" Grid.Row="1" Grid.Column="0" Margin="8,8,0,8" CornerRadius="12" Background="#292A2D">
            <wv2:WebView2 x:Name="ModListWebView" />
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="8" CornerRadius="12" Background="#292A2D">
            <Grid x:Name="BrowserHost" />
        </Border>

        <Border x:Name="ContextShell" Grid.Row="1" Grid.Column="2" Margin="0,8,8,8" CornerRadius="12" Background="#292A2D">
            <wv2:WebView2 x:Name="ContextWebView" />
        </Border>

        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Panel.ZIndex="100"
                Background="#A8E5E7EB"
                IsHitTestVisible="True"
                Visibility="Visible"
                AutomationProperties.Name="Loading local profile">
            <Border Width="390"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#EEF1F3F4"
                    BorderBrush="#B8BEC5"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="LOADING PROFILE"
                               Foreground="#202124"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadingOverlayTitle"
                               Margin="0,12,0,0"
                               Text="Loading local MO2 knowledge..."
                               Foreground="#202124"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadingOverlayPhase"
                               Margin="0,6,0,0"
                               Foreground="#4B5563"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <ProgressBar x:Name="LoadingOverlayProgress"
                                 Margin="0,18,0,0"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Border>

        <Popup x:Name="MorePopup"
               PlacementTarget="{Binding ElementName=ToolbarHost}"
               Placement="Bottom"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="MorePopup_Closed">
            <Border x:Name="MorePopupContent"
                    Width="260"
                    Padding="8"
                    Background="#292A2D"
                    BorderBrush="#56616D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Focusable="True"
                    PreviewKeyDown="MorePopup_PreviewKeyDown">
                <StackPanel>
                    <TextBlock Margin="8,4,8,6"
                               Foreground="#7DD3FC"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="BROWSER" />
                    <Button x:Name="MoreHistoryButton"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreHistoryButton_Click"
                            AutomationProperties.Name="Open browser history">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="History" />
                            <TextBlock x:Name="MoreHistoryCount"
                                       DockPanel.Dock="Right"
                                       Margin="12,0,0,0"
                                       Foreground="#94A3B8"
                                       Text="0" />
                        </DockPanel>
                    </Button>

                    <Separator Margin="4,6" Background="#56616D" />
                    <TextBlock Margin="8,4,8,6"
                               Foreground="#7DD3FC"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="CONTEXT MODE" />
                    <Button x:Name="MoreContextModeContextButton"
                            Tag="context"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreContextModeButton_Click"
                            Content="Context" />
                    <Button x:Name="MoreContextModeSettingsButton"
                            Tag="settings"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreContextModeButton_Click"
                            Content="Settings" />
                    <Button x:Name="MoreContextModeDebugButton"
                            Tag="debug"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreContextModeButton_Click"
                            Content="Debug" />
                    <Button x:Name="MoreContextModeAnalysisButton"
                            Tag="analysis"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreContextModeButton_Click"
                            Content="Analysis" />

                    <TextBlock Margin="8,10,8,6"
                               Foreground="#7DD3FC"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="MOD LIBRARY" />
                    <Button x:Name="MoreModListModeBrowseButton"
                            Tag="browse"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreModListModeButton_Click"
                            Content="Browse" />
                    <Button x:Name="MoreModListModeEditButton"
                            Tag="deployment-edit"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreModListModeButton_Click"
                            Content="Edit profile" />

                    <Separator Margin="4,6" Background="#56616D" />
                    <Button x:Name="MoreModListVisibilityButton"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreModListVisibilityButton_Click"
                            Content="Hide Mod Library" />
                    <Button x:Name="MoreContextVisibilityButton"
                            Style="{StaticResource MorePopupButtonStyle}"
                            Click="MoreContextVisibilityButton_Click"
                            Content="Hide Context" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
